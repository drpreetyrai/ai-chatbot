##############################################################################
#  ARIA — Ambient AI Healthcare Assistant
#  Local development configuration.
#
#  HOW THIS FILE WORKS
#  -------------------
#  1. Copy it:  cp .env.example .env
#  2. Fill in ONLY the sections you want. Every section is INDEPENDENT.
#  3. Anything left blank falls back to a local stub, and the app tells you so
#     in the startup banner and on the UI status chip. Nothing crashes.
#
#  So you can run the whole product end to end RIGHT NOW with an empty .env,
#  then switch on real Azure services one at a time as you get keys.
#
#  IMPORTANT: .env is DEVELOPMENT ONLY. It is in .gitignore. Never commit it.
#  In production every value below comes from Azure Key Vault via managed
#  identity — see plan.md §15.
##############################################################################


# =============================================================================
# SECTION 0 — ENVIRONMENT.  Required. Already filled in. Leave as-is for local.
# =============================================================================
ARIA_ENVIRONMENT=Development
ARIA_REGION_CODE=centralindia

# Hard safety switch. MUST stay false outside a production stamp — the app
# throws at startup if this is true in a non-Production environment.
ARIA_ALLOW_PHI=false

# Where the local database file lives. SQLite for dev; Postgres in prod.
ARIA_SQLITE_PATH=./aria.db


# =============================================================================
# SECTION 1 — THE LANGUAGE MODEL.        ★ THE ONE THAT MATTERS MOST ★
# -----------------------------------------------------------------------------
# WHAT IT POWERS : note drafting, chart Q&A, clinical evidence, message drafts,
#                  entity extraction, intent classification.
# IF LEFT BLANK  : Aria runs on a built-in deterministic clinical model
#                  ("LocalDemoChatClient"). Everything works, output is scripted.
#                  The UI shows an amber  MODEL: LOCAL STUB  chip so you always
#                  know which brain you are talking to.
#
# HOW TO GET IT  : https://ai.azure.com  ->  create a project  ->  Models +
#                  endpoints  ->  Deploy a model  ->  copy the project endpoint
#                  and key. Then create FOUR deployments and put their NAMES
#                  below (names are yours to choose; these are suggestions).
#
#   aria-reasoning : a strong model  — note synthesis, chart Q&A, clinical evidence
#   aria-fast      : a small model   — live extraction, message drafts
#   aria-classify  : a small model   — intent classification
#   aria-embed     : an embedding model — retrieval over guidelines + patient record
# =============================================================================
# ── Option A: OpenAI directly (simplest). Takes precedence over Foundry.
#    Set the four MODEL_* names below to OpenAI model ids, e.g. gpt-4o / gpt-4o-mini.
OPENAI_API_KEY=

# ── Option B: Microsoft Foundry.
#    The MODEL_* names must match DEPLOYMENTS that exist in your project — list them with
#      az cognitiveservices account deployment list -n <resource> -g <rg>
#    A router deployment usually routes to a REASONING model, which is too slow for the
#    fast path; deploy a small model and point MODEL_FAST/CLASSIFY at it.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=

MODEL_REASONING_DEPLOYMENT=aria-reasoning
MODEL_FAST_DEPLOYMENT=aria-fast
MODEL_CLASSIFY_DEPLOYMENT=aria-classify
MODEL_EMBED_DEPLOYMENT=aria-embed

# Per-task timeouts (seconds). Tuned in plan.md §1.4. Safe to leave.
MODEL_TIMEOUT_REASONING_SECONDS=25
# 12s, not 6: live extraction runs on a rolling 45-second window, and a real
# network round trip to a hosted model regularly overran six. Degrading is safe
# (the allergy check runs on a deterministic scan regardless) but it costs the
# note its structured entities, so it should be the exception, not every pass.
MODEL_TIMEOUT_FAST_SECONDS=12
MODEL_TIMEOUT_CLASSIFY_SECONDS=2


# =============================================================================
# SECTION 2 — AZURE AI CONTENT SAFETY.   ★ THE GUARDRAIL SERVICE ★
# -----------------------------------------------------------------------------
# WHAT IT POWERS : Prompt Shields (prompt-injection detection, direct AND
#                  indirect), groundedness detection, text moderation.
# IF LEFT BLANK  : a local heuristic shield runs instead. It catches the obvious
#                  attacks in evals/datasets/injection-attacks-v1.jsonl but it is
#                  NOT production-grade. The UI shows  SHIELD: LOCAL HEURISTIC.
#
# HOW TO GET IT  : Azure portal -> Create resource -> "Azure AI Content Safety"
#                  -> Keys and Endpoint.
# =============================================================================
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# block = reject on detection (use this).  audit = log only (dev experiments).
ARIA_PROMPT_SHIELD_MODE=block
ARIA_GROUNDEDNESS_THRESHOLD=0.75


# =============================================================================
# SECTION 3 — AZURE AI SPEECH.           (ambient capture)
# -----------------------------------------------------------------------------
# WHAT IT POWERS : real-time transcription of the consultation, with speaker
#                  diarisation (who said what — doctor vs patient).
# IF LEFT BLANK  : the encounter screen replays a scripted consultation from
#                  evals/datasets/demo-encounter.json at realistic speed. This
#                  is Demo Mode from plan.md §14 and it is a real feature —
#                  it is how clinicians are onboarded and how CI smoke-tests
#                  the pipeline. You do NOT need this key to see the product work.
#
# HOW TO GET IT  : Azure portal -> Create resource -> "Speech service".
# =============================================================================
SPEECH_ENDPOINT=
SPEECH_KEY=
SPEECH_REGION=centralindia


# =============================================================================
# SECTION 4 — AZURE AI LANGUAGE (Text Analytics for Health).
# -----------------------------------------------------------------------------
# WHAT IT POWERS : DETERMINISTIC clinical entity extraction — drugs, doses,
#                  symptoms, negation ("denies chest pain"), UMLS codes.
#                  This is not a generative model; its output is authoritative
#                  and it is what the allergy checker keys off.
# IF LEFT BLANK  : a built-in clinical lexicon extractor runs. Good enough for
#                  the demo dataset; add the key for real vocabulary coverage.
#
# HOW TO GET IT  : Azure portal -> Create resource -> "Language service"
#                  -> enable "Text Analytics for health".
# =============================================================================
LANGUAGE_ENDPOINT=
LANGUAGE_KEY=


# =============================================================================
# SECTION 5 — AZURE AI SEARCH.           (retrieval / RAG)
# -----------------------------------------------------------------------------
# WHAT IT POWERS : "Ask this chart" (patient-scoped retrieval) and the clinical
#                  evidence drawer (guideline retrieval with citations).
# IF LEFT BLANK  : an in-process hybrid keyword+vector index is built at startup
#                  over the seeded guideline pack and the patient records in the
#                  local DB. Citations still resolve — the citation-enforcement
#                  guardrail is fully exercised either way.
#
# HOW TO GET IT  : Azure portal -> Create resource -> "AI Search".
# =============================================================================
SEARCH_ENDPOINT=
SEARCH_KEY=
SEARCH_INDEX_GUIDELINES=guidelines-v1
SEARCH_INDEX_PATIENTS=patient-records


# =============================================================================
# SECTION 6 — GOOGLE CALENDAR.           (scheduling)
# -----------------------------------------------------------------------------
# WHAT IT POWERS : reading the doctor's real free/busy, holding slots, booking
#                  the follow-up after a note is signed.
# IF LEFT BLANK  : an in-memory calendar seeded with a realistic clinic week.
#                  Slot proposals, holds, buffers and conflict detection all
#                  work; nothing leaves your machine.
#
# HOW TO GET IT  : https://console.cloud.google.com -> APIs & Services
#                  -> enable "Google Calendar API"
#                  -> Credentials -> Create OAuth 2.0 Client ID (Web application)
#                  -> add the redirect URI below VERBATIM to "Authorized
#                     redirect URIs" (Google matches it character for character;
#                     a trailing slash or the wrong port fails with redirect_uri_mismatch).
#                  -> OAuth consent screen -> add yourself as a Test user.
# SCOPES NEEDED  : calendar.events, calendar.freebusy
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:7001/v1/integrations/google/callback


# =============================================================================
# SECTION 7 — WHATSAPP BUSINESS CLOUD API.   (patient communication)
# -----------------------------------------------------------------------------
# WHAT IT POWERS : outbound reminders and post-visit summaries, inbound patient
#                  messages, the 24-hour service window, red-flag escalation
#                  on inbound text.
# IF LEFT BLANK  : a simulated WhatsApp thread. The Inbox is fully interactive —
#                  you can type as the patient (including "chest tightness" to
#                  watch the escalation path fire) and approve AI drafts.
#                  Messages are not actually sent anywhere.
#
# HOW TO GET IT  : https://developers.facebook.com -> create a Business app
#                  -> add "WhatsApp" product -> API Setup gives you the phone
#                  number ID, business account ID and a temporary access token.
#                  App secret is under App Settings -> Basic.
# WEBHOOK        : point it at  <your public url>/v1/webhooks/whatsapp
#                  and use the verify token you set below.
# =============================================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=aria-local-verify-token


# =============================================================================
# SECTION 8 — EHR (FHIR R4).             (writing the signed note back)
# -----------------------------------------------------------------------------
# WHAT IT POWERS : after signature, Aria writes a DocumentReference to the EHR.
# IF LEFT BLANK  : writes go to a local FHIR-shaped store you can inspect at
#                  GET /v1/admin/fhir-inbox — so you can prove the write barrier
#                  works without an EHR.
#
# HOW TO GET IT  : any FHIR R4 server. Azure Health Data Services, or for a
#                  quick test the public HAPI sandbox: https://hapi.fhir.org/baseR4
# =============================================================================
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=


# =============================================================================
# SECTION 9 — IDENTITY (Microsoft Entra ID).
# -----------------------------------------------------------------------------
# WHAT IT POWERS : real SSO, MFA, and the doctor_id/department claims that the
#                  whole RBAC and tenancy model keys on.
# IF LEFT BLANK  : a local dev identity provider issues tokens for the seeded
#                  clinicians. Pick who you are from the sign-in screen —
#                  Dr. Maya Rao (clinician), Ravi (coordinator), Priya (admin).
#                  RBAC, RLS and the audit trail are all fully enforced.
#
# HOW TO GET IT  : https://entra.microsoft.com -> App registrations -> New.
# =============================================================================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ARIA_API_AUDIENCE=api://aria

# Signing key for the LOCAL dev identity provider only. Ignored when Entra is
# configured. Change it to any long random string.
ARIA_DEV_JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef


# =============================================================================
# SECTION 10 — OBSERVABILITY.
# -----------------------------------------------------------------------------
# IF LEFT BLANK  : OpenTelemetry traces print to the console and are queryable
#                  in-app at GET /v1/admin/traces (the Insights screen reads it).
# HOW TO GET IT  : Azure portal -> Application Insights -> Connection String.
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=aria-api

# NEVER set this true in production. Prompts and completions contain PHI.
ARIA_OTEL_CAPTURE_CONTENT=false


# =============================================================================
# SECTION 11 — SAFETY & GOVERNANCE DIALS.  Sensible defaults. Change carefully.
# =============================================================================
ARIA_CONFIDENCE_LOW=0.65
ARIA_CONFIDENCE_HIGH=0.85
ARIA_ESCALATION_ACK_SLA_SECONDS=120
ARIA_AUDIO_RETENTION_DAYS=0
ARIA_MESSAGE_UNDO_SECONDS=30

# The red-flag classifier only WIDENS the deterministic keyword net. Too tight and it
# times out on every call, which fails safe into escalating everything. The detector
# drops a persistently slow classifier rather than letting that happen.
ARIA_REDFLAG_CLASSIFIER_TIMEOUT_MS=4000

# Autonomy dials (plan.md §10.4). draft = human approves every time.
# auto = send without approval. red_flag_escalation is HARD-WIRED to human and
# the API returns 422 if you try to change it — deliberately impossible.
ARIA_AUTONOMY_APPOINTMENT_REMINDER=auto
ARIA_AUTONOMY_POST_VISIT_SUMMARY=draft
ARIA_AUTONOMY_RESCHEDULE_OFFERS=draft
ARIA_AUTONOMY_CLINICAL_QA_REPLIES=draft


# =============================================================================
# SECTION 12 — FRONTEND.
#  ⚠️  EVERYTHING PREFIXED  VITE_  IS COMPILED INTO THE BROWSER BUNDLE AND IS
#      PUBLIC. NEVER PUT A SECRET HERE. CI fails the build if a VITE_ key
#      matches *_SECRET / *_KEY / *_TOKEN / *_PASSWORD.
# =============================================================================
VITE_API_BASE_URL=http://localhost:5199
VITE_DEMO_MODE_ENABLED=true
